{
  "name": "voxshelf",
  "version": "1.0.0",
  "private": true,
  "description": "VoxShelf - self-hostable text-to-speech app powered by Gemini speech generation",
  "author": "VoxShelf",
  "desktopName": "app.voxshelf",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 38492",
    "build": "next build",
    "start": "next start -p 38492",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "electron .",
    "desktop:icons": "node scripts/make-icons.mjs",
    "desktop:build": "node scripts/electron-build.mjs"
  },
  "build": {
    "appId": "app.voxshelf",
    "productName": "VoxShelf",
    "directories": { "output": "dist" },
    "files": ["electron/**/*", ".next/standalone/**/*", "package.json"],
    "asarUnpack": [".next/standalone/**/*", "**/*.node"],
    "npmRebuild": false,
    "mac": {
      "icon": "electron/assets/icon.icns",
      "target": ["dmg", "zip"],
      "category": "public.app-category.music"
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": ["AppImage"],
      "category": "Audio",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.1.0",
    "@google/genai": "^1.0.0",
    "@mozilla/readability": "^0.5.0",
    "better-sqlite3": "^12.0.0",
    "jsdom": "^24.1.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.6.0",
    "next": "^15.0.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Optional shared-key lock: when set, browsers must unlock and API clients
# must send `Authorization: Bearer <key>` (sync peers use the sync key field).
# Empty = open server (fine on a trusted LAN).
API_KEY=

# Data directory (sqlite db + audio cache). In docker this is /app/data (volume).
DATA_DIR=./data

# Port
PORT=38492

# Library sync (see docs/SYNC.md). Empty = standalone mode.
# Desktop apps usually set this in Settings > Library sync instead.
SYNC_SERVER_URL=
SYNC_ENABLED=
SYNC_INTERVAL_MS=60000
SYNC_MODE=full
SYNC_API_KEY=
